# ──────────────────────────────────────────────────────────────
# MuscleLock AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ── Supabase Edge Function Secrets (set via Supabase CLI) ────
# These are server-side only — never put them here for the browser.
# Set them with: supabase secrets set KEY=value
#
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  (backend only)
# STRIPE_SECRET_KEY=sk_live_...                    (backend only)
# STRIPE_WEBHOOK_SECRET=whsec_...                  (backend only)
# LOVABLE_API_KEY=...                              (backend only)
